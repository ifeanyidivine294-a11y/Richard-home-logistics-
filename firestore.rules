rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL DENY DEFAULT ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'chukwudebeifeanyi6@gmail.com' ||
          request.auth.token.email == 'admin@richardhomelogistics.com'
        ))
      );
    }

    // --- VALIDATION BLUEPRINTS ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 150;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'reference', 'orderType', 'subtotal', 'grandTotal', 'status']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.reference is string && data.reference.size() > 0 && data.reference.size() <= 100 &&
        data.orderType in ['delivery', 'pickup'] &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.grandTotal is number && data.grandTotal >= 0 &&
        data.status is string && data.status.size() <= 100;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'subcategory', 'price']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.price is number && data.price >= 0;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150;
    }

    function isValidDeliveryArea(data) {
      return data.keys().hasAll(['id', 'name', 'fee']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.fee is number && data.fee >= 0;
    }

    function isValidBusinessSettings(data) {
      return data.keys().hasAll(['storeName', 'whatsAppNumber', 'displayPhone']) &&
        data.storeName is string && data.storeName.size() > 0 && data.storeName.size() <= 150 &&
        data.whatsAppNumber is string && data.whatsAppNumber.size() > 0 && data.whatsAppNumber.size() <= 50;
    }

    function isValidFavourite(data) {
      return data.keys().hasAll(['userId', 'productId']) &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128;
    }

    // --- COLLECTION RULES ---

    // 1. Users Collection (Customer profiles & PII)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && isValidUser(incoming()) && incoming().uid == existing().uid)
      );
      allow delete: if isAdmin();
    }

    // 2. Products Collection (Public Catalog)
    match /products/{productId} {
      allow read: if true;
      allow create, update: if (isAdmin() && isValidProduct(incoming())) || !exists(/databases/$(database)/documents/products/$(productId));
      allow delete: if isAdmin();
    }

    // 3. Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCategory(incoming());
      allow delete: if isAdmin();
    }

    // 4. Delivery Areas
    match /deliveryAreas/{areaId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidDeliveryArea(incoming());
      allow delete: if isAdmin();
    }

    // 5. Business Settings & Banners
    match /businessSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepageBanners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Orders Collection (Customer WhatsApp and Delivery Orders)
    match /orders/{orderId} {
      allow create: if isValidOrder(incoming());
      allow get: if isAdmin() || (isSignedIn() && resource.data.customerId != null && resource.data.customerId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId != null && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 7. Favourites Collection
    match /favourites/{favId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId != null && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId != null && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidFavourite(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidFavourite(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // 8. Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // 9. Connection Health Check
    match /test/{testId} {
      allow get: if true;
    }
  }
}
